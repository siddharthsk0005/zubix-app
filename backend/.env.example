# Database (Supabase/Postgres). DIRECT_URL is used by Prisma migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/zubix?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/zubix?schema=public"

# Server
NODE_ENV=development
PORT=4000

# Comma-separated origins allowed to call the API (web dashboards and dev hosts)
CORS_ORIGINS=http://localhost:8080

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Demo OTP. Only honoured when NODE_ENV is not "production".
DEMO_OTP_ENABLED=true
DEMO_OTP_CODE=9001
